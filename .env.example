# 环境变量配置
# 应用
APP_NAME=his-agent-platform
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=medical
DB_PASSWORD=medical123
DB_NAME=medical_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RustFS（S3 兼容对象存储，替代 MinIO）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-docs
RUSTFS_SECURE=false
RUSTFS_REGION=us-east-1

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123

DASHSCOPE_API_KEY=xxxx
# 聊天模型
BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max

DEEPSEEK_API_KEY=xxx
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=

# Embedding（长期记忆与知识库向量化）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=qwen3-rerank

# JWT
# 生产必须配置 JWT_SECRET_KEY，否则启动失败
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# access token 有效期（分钟）。登出后的暴露窗口约等于该值，建议 15~30
ACCESS_TOKEN_TTL_MINUTES=30
# 登出全部设备的失效时间点保留天数
AUTH_REVOCATION_TTL_DAYS=90
# Redis 不可用时管理端是否拒绝放行（生产建议 true，会牺牲可用性换安全）
AUTH_ADMIN_FAIL_CLOSED=false

# 并发与超时
LLM_MAX_CONCURRENCY=200
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
TURN_TIMEOUT=150
SSE_MAX_CONNS=4000

# 检索参数（RAG / NL2SQL），不配则用代码中的默认值
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
MILVUS_NPROBE=16
GRAPH_RAG_RECORD_LIMIT=20
NL2SQL_MAX_RETRIES=2
NL2SQL_TIMEOUT_SECONDS=10
NL2SQL_ROW_LIMIT=100
FUSION_SNIPPET_LIMIT=1000
DOC_LIST_LIMIT=500

# CORS（生产环境按需收紧）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 其他
MILVU_CACHE_ENABLED=true
# 图片报告 OCR 兜底：MinerU 未部署时用它识别 jpg/png 报告文字（需网关支持视觉模型）
VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
VL_OCR_ENABLED=true
VL_OCR_TIMEOUT=90
VL_OCR_MAX_SIDE=1600
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ── 单轮执行限额（防跑飞 / 防刷） ──────────────────────────────────────
AGENT_MAX_CALLS=12
TOOL_MAX_CALLS=20
TURN_MAX_TOKENS=60000
RETRIEVAL_MAX_RESULTS=8
USER_MAX_CONCURRENT_TASKS=2

# ── 配置热加载 ────────────────────────────────────────────────────────
# 管理端保存后本进程立即生效；这里是多副本之间允许的最大滞后（秒）。
# 单实例部署可设为 0 关闭轮询，只靠管理端主动刷新。
AGENT_CONFIG_REFRESH_SECONDS=30

# ── Safety Engine ─────────────────────────────────────────────────────
SAFETY_ENABLED=true
SAFETY_REVIEW_REQUIRED_LEVEL=high
SAFETY_BLOCK_ON_CRITICAL=true
SAFETY_MAX_INPUT_CHARS=4000

# ── 可观测性与审计保留周期（天） ───────────────────────────────────────
TRACE_RETENTION_DAYS=180
SAFETY_EVENT_RETENTION_DAYS=365
ACCESS_LOG_RETENTION_DAYS=30
TRACE_SAMPLE_RATE=1.0
